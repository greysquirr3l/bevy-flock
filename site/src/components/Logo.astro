---
// A mark made of five dots converging on one: a flock, not a logo. Pure SVG so it stays sharp in the sidebar and the
// favicon has something to point at.
---
<span class="mark" aria-hidden="true">
  <svg viewBox="0 0 32 32" width="24" height="24">
    <circle cx="6" cy="24" r="3" fill="currentColor" opacity="0.55" />
    <circle cx="24" cy="24" r="3" fill="currentColor" opacity="0.55" />
    <circle cx="16" cy="26" r="2.5" fill="currentColor" opacity="0.75" />
    <circle cx="11" cy="16" r="2.5" fill="currentColor" opacity="0.85" />
    <circle cx="21" cy="15" r="2.5" fill="currentColor" opacity="0.85" />
    <circle cx="16" cy="7" r="4" fill="currentColor" />
  </svg>
  <span class="wordmark">bevy-flock</span>
</span>
<style>
  .mark { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--sl-color-accent-high); }
  .wordmark { font-weight: 700; letter-spacing: -0.01em; color: var(--sl-color-white); }
  :root[data-theme='light'] .wordmark { color: var(--sl-color-black); }
</style>
